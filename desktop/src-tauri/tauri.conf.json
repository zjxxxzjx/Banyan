{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Banyan",
  "version": "0.2.1",
  "identifier": "fun.banyan.git",
  "build": {
    "frontendDist": "../../public",
    "devUrl": "http://127.0.0.1:7788"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' http://127.0.0.1:*; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../../server.js": "server.js",
      "../../lib/": "lib/",
      "../../public/": "public/"
    },
    "externalBin": ["binaries/node"],
    "macOS": {
      "minimumSystemVersion": "10.15",
      "signingIdentity": "Banyan Local Signer",
      "entitlements": "entitlements.plist"
    }
  }
}